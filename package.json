{
  "name": "@forge-ahead/dummyjson",
  "version": "0.1.0",
  "private": true,
  "description": "A default client for the DummyJSON API, shared by Forge examples.",
  "keywords": [
    "atlassian",
    "forge",
    "dummyjson",
    "api-client"
  ],
  "homepage": "https://github.com/ibuchanan/forge-ahead-dummyjson#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibuchanan/forge-ahead-dummyjson.git"
  },
  "license": "Apache-2.0",
  "author": "Ian Buchanan",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "changelog": "touch CHANGELOG.md && git cliff --offline --unreleased --prepend CHANGELOG.md",
    "check": "lefthook run check",
    "clean": "bun run clean:build",
    "clean:build": "rm -rf ./dist ./coverage",
    "clean:install": "bun run clean:build && rm -rf package-lock.json bun.lock ./node_modules ./cocoindex_code",
    "contract:check": "bun run scripts/generate-contract.ts --check && openapi-typescript --check",
    "contract:update": "git -C vendor/DummyJSON fetch origin && git -C vendor/DummyJSON checkout origin/HEAD",
    "format": "biome format --write",
    "format:check": "biome format",
    "generate:contract": "bun run scripts/generate-contract.ts --draft",
    "generate:types": "openapi-typescript",
    "lint": "lefthook run lint",
    "lint:check": "biome lint",
    "lint:fix": "biome lint --write",
    "pack:check": "bun run build && bun run pack:lint",
    "pack:lint": "lefthook run pack-lint",
    "prepare": "bun run build && (lefthook install || true)",
    "release:prepare": "bun run scripts/release-prepare.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@forge-ahead/errors": "github:ibuchanan/forge-ahead-errors",
    "openapi-fetch": "^0.17"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18",
    "@biomejs/biome": "2.5.15",
    "@types/bun": "^1.4",
    "@types/node": "22",
    "lefthook": "^2.1",
    "openapi-typescript": "^7.13",
    "publint": "^0.3",
    "quicktype": "^26.0",
    "tsdown": "^0.23",
    "typescript": "^5.9"
  },
  "peerDependencies": {
    "@forge/api": "^8.2.0"
  },
  "engines": {
    "node": ">=22"
  },
  "trustedDependencies": [
    "@forge-ahead/errors"
  ]
}
