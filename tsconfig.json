{
  "$schema": "https://json.schemastore.org/tsconfig",
  "include": ["src", "test"],
  "exclude": ["test/fixtures"],
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "rootDir": ".",
    "noEmit": false,
    "outDir": "dist",
    "sourceMap": true
  }
}
